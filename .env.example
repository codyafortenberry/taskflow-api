# Copy to .env and adjust. docker-compose reads these automatically.
# Values here are safe demo defaults — never commit real secrets.

# Postgres
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow

# API — override the JWT signing key in any real deployment (min 32 chars).
Jwt__SigningKey=super-secret-demo-signing-key-please-override-in-prod-32bytes+
Jwt__Issuer=taskflow-api
Jwt__Audience=taskflow-clients
